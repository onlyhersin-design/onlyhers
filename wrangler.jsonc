{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "onlyhers",
  "pages_build_output_dir": "./",
  "compatibility_date": "2025-01-01",
  "vars": {
    "IMAGE_BASE_URL": "https://images.onlyhers.in"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onlyhers-production",
      "database_id": "f58147c9-1c4c-40ff-b1ba-b840634e903f",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "onlyhers-assets"
    }
  ]
}
